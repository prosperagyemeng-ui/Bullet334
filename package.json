{
  "name": "prosperstream",
  "version": "1.0.0",
  "description": "ProsperStream - Modern Video Streaming Platform. Stream the Future.",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon --exec babel-node server/index.js",
    "client": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "server:prod": "node dist/server/index.js",
    "build:server": "babel server --out-dir dist/server",
    "build:all": "npm run build:server && npm run build",
    "lint": "eslint src server",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md}\""
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.0",
    "axios": "^1.4.0",
    "tailwindcss": "^3.3.0",
    "postcss": "^8.4.27",
    "autoprefixer": "^10.4.14",
    "framer-motion": "^10.12.0",
    "jwt-decode": "^3.1.2",
    "stripe": "^12.0.0",
    "firebase": "^10.0.0",
    "react-icons": "^4.10.0",
    "swiper": "^10.0.0",
    "video-react": "^0.16.0",
    "zustand": "^4.3.9",
    "react-hot-toast": "^2.4.0",
    "react-infinite-scroll-component": "^6.1.0",
    "socket.io-client": "^4.6.0",
    "date-fns": "^2.30.0",
    "react-helmet": "^6.1.0",
    "clsx": "^2.0.0",
    "react-query": "^3.39.3",
    "recharts": "^2.8.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.22.0",
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "react-scripts": "5.0.1",
    "nodemon": "^2.0.22",
    "concurrently": "^8.2.0",
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "mongoose": "^7.2.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.1",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.6.0",
    "cloudinary": "^1.40.0",
    "express-validator": "^7.0.0",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.10.0",
    "compression": "^1.7.4",
    "eslint": "^8.45.0",
    "prettier": "^3.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:5000"
}
